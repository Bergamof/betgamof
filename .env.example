# Shared secret between the frontend server and the API (e.g. `openssl rand -hex 32`).
BETGAMOF_API_TOKEN=change-me
# Password asked on the login page.
BETGAMOF_APP_PASSWORD=change-me-too
# Public URL of the app (use your https:// domain behind a reverse proxy).
BETGAMOF_ORIGIN=http://localhost:3000
BETGAMOF_PORT=3000
# Fill an empty database with demo data on first start.
BETGAMOF_SEED_DEMO=false
